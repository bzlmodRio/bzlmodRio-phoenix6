load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "shared_interface",
    srcs = select({
        "@wpilib_toolchains//conditions:windows_x86_64": ["@bazelrio_com_ctre_phoenix6_api-cpp_windowsx86-64//:shared_interface"],
