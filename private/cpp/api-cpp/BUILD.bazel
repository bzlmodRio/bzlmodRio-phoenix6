        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@bazelrio_com_ctre_phoenix6_api-cpp_linuxsystemcore//:shared"],
        "@wpilib_toolchains//constraints/is_trixie64:trixie64": ["@bazelrio_com_ctre_phoenix6_api-cpp_linuxarm64//:shared"],
        "//conditions:default": [],
