load("@rules_cc//cc:defs.bzl", "cc_library")

alias(
    name = "phoenix6-cpp",
    actual = ":shared",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "shared",
    linkstatic = 1,
    visibility = ["//visibility:public"],
    deps = [
        "@bzlmodrio-allwpilib//libraries/cpp/drivers:shared",
        "@bzlmodrio-allwpilib//libraries/cpp/fields:shared",
        "@bzlmodrio-allwpilib//libraries/cpp/mrclib:shared",
        "@bzlmodrio-allwpilib//libraries/cpp/wpilibc:shared",
        "@bzlmodrio-phoenix6//libraries/cpp/phoenix6-hal:shared",
    ] +
    # Binaries
    select({
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": [
            "//private/cpp/wpiapi-cpp:shared",
        ],
        "//conditions:default": [
            "//private/cpp/wpiapi-cpp-sim:shared",
        ],
    }),
)
